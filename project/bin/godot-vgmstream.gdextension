[configuration]

entry_symbol = "godot_vgmstream_library_init"
compatibility_minimum = "4.1"
reloadable = false

[libraries]
macos.single.debug = "./macos/libgodot-vgmstream.macos.template_debug.dylib"
macos.double.debug = "./macos/libgodot-vgmstream.macos.template_debug.double.dylib"
macos.single.release = "./macos/libgodot-vgmstream.macos.template_release.dylib"
macos.double.release = "./macos/libgodot-vgmstream.macos.template_release.double.dylib"

ios.arm64.single.debug = "./ios/libgodot-vgmstream.ios.template_debug.arm64.dylib"
ios.arm64.double.debug = "./ios/libgodot-vgmstream.ios.template_debug.arm64.double.dylib"
ios.arm64.single.release = "./ios/libgodot-vgmstream.ios.template_release.arm64.dylib"
ios.arm64.double.release = "./ios/libgodot-vgmstream.ios.template_release.arm64.double.dylib"

windows.x86_64.single.debug = "./windows/libgodot-vgmstream.windows.template_debug.x86_64.dll"
windows.x86_64.double.debug = "./windows/libgodot-vgmstream.windows.template_debug.double.x86_64.dll"
windows.x86_64.single.release = "./windows/libgodot-vgmstream.windows.template_release.x86_64.dll"
windows.x86_64.double.release = "./windows/libgodot-vgmstream.windows.template_release.double.x86_64.dll"

windows.arm64.single.debug = "./windows/libgodot-vgmstream.windows.template_debug.arm64.dll"
windows.arm64.double.debug = "./windows/libgodot-vgmstream.windows.template_debug.double.arm64.dll"
windows.arm64.single.release = "./windows/libgodot-vgmstream.windows.template_release.arm64.dll"
windows.arm64.double.release = "./windows/libgodot-vgmstream.windows.template_release.double.arm64.dll"

linux.x86_64.single.debug = "./linux/libgodot-vgmstream.linux.template_debug.x86_64.so"
linux.x86_64.double.debug = "./linux/libgodot-vgmstream.linux.template_debug.double.x86_64.so"
linux.x86_64.single.release = "./linux/libgodot-vgmstream.linux.template_release.x86_64.so"
linux.x86_64.double.release = "./linux/libgodot-vgmstream.linux.template_release.double.x86_64.so"

linux.arm64.single.debug = "./linux/libgodot-vgmstream.linux.template_debug.arm64.so"
linux.arm64.double.debug = "./linux/libgodot-vgmstream.linux.template_debug.double.arm64.so"
linux.arm64.single.release = "./linux/libgodot-vgmstream.linux.template_release.arm64.so"
linux.arm64.double.release = "./linux/libgodot-vgmstream.linux.template_release.double.arm64.so"

android.x86_64.single.debug = "./android/libgodot-vgmstream.android.template_debug.x86_64.so"
android.x86_64.double.debug = "./android/libgodot-vgmstream.android.template_debug.double.x86_64.so"
android.x86_64.single.release = "./android/libgodot-vgmstream.android.template_release.x86_64.so"
android.x86_64.double.release = "./android/libgodot-vgmstream.android.template_release.double.x86_64.so"

android.arm64.single.debug = "./android/libgodot-vgmstream.android.template_debug.arm64.so"
android.arm64.double.debug = "./android/libgodot-vgmstream.android.template_debug.double.arm64.so"
android.arm64.single.release = "./android/libgodot-vgmstream.android.template_release.arm64.so"
android.arm64.double.release = "./android/libgodot-vgmstream.android.template_release.double.arm64.so"

web.wasm32.single.debug = "./web/libgodot-vgmstream.web.template_debug.wasm32.nothreads.wasm"
web.wasm32.double.debug = "./web/libgodot-vgmstream.web.template_debug.double.nothreads.wasm"
web.wasm32.single.release = "./web/libgodot-vgmstream.web.template_release.wasm32.nothreads.wasm"
web.wasm32.double.release = "./web/libgodot-vgmstream.web.template_release.double.nothreads.wasm"
